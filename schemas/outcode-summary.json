{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.postcodecontext.uk/schemas/outcode-summary.json",
  "title": "OutcodeSummaryResponse",
  "type": "object",
  "description": "District-wide demographic, housing valuation, and socio-economic aggregation across all registered postcodes in a Great Britain outward postal district (e.g. BB7, SW1A, EH1, CF10).",
  "required": [
    "outcode",
    "_attribution"
  ],
  "properties": {
    "outcode": {
      "type": "string",
      "example": "BB7",
      "description": "Outward postal district code (e.g. BB7, SW1A, EH1, CF10)"
    },
    "total_postcodes": {
      "type": "integer",
      "example": 1420,
      "description": "Total number of live registered unit postcodes aggregated within this outward district"
    },
    "district_median_house_price_gbp": {
      "type": [
        "integer",
        "null"
      ],
      "example": 358398,
      "description": "District-wide median residential transaction price in GBP from 3-year rolling sales (HMLR / RoS)"
    },
    "district_avg_price_per_sqm_gbp": {
      "type": [
        "integer",
        "null"
      ],
      "example": 2480,
      "description": "District-wide mean transaction price per internal square metre in GBP"
    },
    "average_affluence_score_100": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "example": 62,
      "description": "District-wide mean composite affluence score on a 1–100 scale"
    },
    "dominant_affluence_tier": {
      "type": "string",
      "enum": [
        "Ultra-Prime",
        "Affluent",
        "Mid-Market",
        "Modest-Income",
        "High-Deprivation"
      ],
      "example": "Mid-Market",
      "description": "Most common affluence tier across unit postcodes within the district"
    },
    "imd_overall_decile_range": {
      "type": "object",
      "description": "Spread of statutory Index of Multiple Deprivation deciles across constituent neighborhoods within the district (1 = most deprived 10% nationally, 10 = least deprived / safest 10%)",
      "required": [
        "min",
        "max"
      ],
      "example": {
        "min": 3,
        "max": 10
      },
      "properties": {
        "min": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 10,
          "example": 3,
          "description": "Lowest (most deprived) IMD decile recorded in any constituent LSOA or Data Zone in this district"
        },
        "max": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 10,
          "example": 10,
          "description": "Highest (least deprived) IMD decile recorded in any constituent LSOA or Data Zone in this district"
        }
      }
    },
    "top_personas": {
      "type": "array",
      "items": {
        "type": "string",
        "example": "Rural Agrarian & Village Communities"
      },
      "example": [
        "Rural Agrarian & Village Communities",
        "Comfortable Suburban Achievers"
      ],
      "description": "Ranked list of dominant demographic and socio-economic persona archetypes in the district"
    },
    "sample_postcodes": {
      "type": "array",
      "items": {
        "type": "string",
        "example": "BB7 1AA"
      },
      "example": [
        "BB7 1AA",
        "BB7 1AB",
        "BB7 1AD",
        "BB7 1AE",
        "BB7 1AF"
      ],
      "description": "Representative sample of unit postcodes situated within this district"
    },
    "district_context_briefing": {
      "type": "string",
      "example": "Outward postal district BB7 encompasses 1420 registered postcode sector areas in Ribble Valley (North West). Baseline property values median at £358,398 (£2,480/sqm) with composite district affluence scored at 62/100 (Mid-Market). IMD deprivation ranges from decile 3 to 10.",
      "description": "Pre-synthesized natural language summary designed for LLM context window ingestion"
    },
    "schools_and_education": {
      "$ref": "#/components/schemas/EducationAndSchools",
      "description": "Educational infrastructure proximate to the district"
    },
    "healthcare_and_services": {
      "$ref": "#/components/schemas/HealthcareAndServices",
      "description": "Healthcare facilities proximate to the district"
    },
    "transit": {
      "$ref": "#/components/schemas/Transit",
      "description": "Public transport nodes proximate to the district"
    },
    "_disclaimer": {
      "type": "string",
      "example": "PostcodeContext provides automated statistical intelligence for informational purposes only.",
      "description": "Statutory non-advice legal disclaimer"
    },
    "_attribution": {
      "type": "string",
      "example": "Contains OS data © Crown copyright and database right 2026. Contains Royal Mail data © Royal Mail copyright and Database right 2026. Contains National Records of Scotland data. Licensed under OGL v3.0.",
      "description": "Official statutory Crown copyright and Open Government Licence v3.0 attribution statement"
    },
    "_licensing": {
      "$ref": "#/components/schemas/LicensingInfo",
      "description": "Statutory attribution and licensing metadata across data providers"
    },
    "_billing": {
      "$ref": "#/components/schemas/BillingReceipt",
      "description": "Settled on-chain transaction receipt metadata"
    }
  },
  "components": {
    "schemas": {
      "EducationAndSchools": {
        "type": "object",
        "properties": {
          "nearest_primary_school": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SchoolSummary"
              },
              {
                "type": "null"
              }
            ]
          },
          "nearest_secondary_school": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SchoolSummary"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "SchoolSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "ENG-101138"
          },
          "name": {
            "type": "string",
            "example": "St Matthew's School, Westminster"
          },
          "phase": {
            "type": "string",
            "example": "Primary"
          },
          "gender": {
            "type": "string",
            "example": "Mixed"
          },
          "religious_character": {
            "type": [
              "string",
              "null"
            ],
            "example": "Church of England"
          },
          "admissions_policy": {
            "type": [
              "string",
              "null"
            ],
            "example": "Non-selective"
          },
          "distance_km": {
            "type": "number",
            "example": 0.54
          }
        }
      },
      "HealthcareAndServices": {
        "type": "object",
        "properties": {
          "nearest_gp_surgery": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/HealthcareSummary"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "HealthcareSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "CQC-1-12687408410"
          },
          "name": {
            "type": "string",
            "example": "Medloop"
          },
          "care_type": {
            "type": "string",
            "example": "GP Practice"
          },
          "distance_km": {
            "type": "number",
            "example": 0.48
          },
          "regulator": {
            "type": "string",
            "example": "CQC"
          },
          "rating": {
            "type": [
              "string",
              "null"
            ],
            "example": "Good"
          },
          "inspection_date": {
            "type": [
              "string",
              "null"
            ],
            "example": "22/Jan/2024"
          }
        }
      },
      "Transit": {
        "type": "object",
        "properties": {
          "nearest_station": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/StationSummary"
              },
              {
                "type": "null"
              }
            ],
            "description": "Closest rail, metro, or tram stop of any category"
          },
          "nearest_intercity_hub": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/StationSummary"
              },
              {
                "type": "null"
              }
            ],
            "description": "Closest primary mainline intercity railway hub (>= 2M annual passengers or Network Rail Category A/B interchange)"
          }
        }
      },
      "StationSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "9100MNCRVIC"
          },
          "name": {
            "type": "string",
            "example": "Manchester Victoria"
          },
          "station_type": {
            "type": "string",
            "example": "National Rail"
          },
          "hub_type": {
            "type": "string",
            "enum": [
              "national_hub",
              "regional_hub",
              "commuter_hub",
              "local_station"
            ],
            "example": "national_hub",
            "description": "Station hierarchy classification based on ORR annual passenger footfall: national_hub (>=10M/yr or Cat A), regional_hub (>=2M/yr or Cat B), commuter_hub (500k-2M/yr), or local_station (<500k/yr)."
          },
          "distance_km": {
            "type": "number",
            "example": 0.35
          }
        }
      },
      "LicensingInfo": {
        "type": "object",
        "required": [
          "licence",
          "licence_url",
          "territorial_scope",
          "attribution_summary",
          "database_last_updated",
          "baseline_vintage",
          "update_cadence"
        ],
        "properties": {
          "licence": {
            "type": "string",
            "example": "Open Government Licence v3.0"
          },
          "licence_url": {
            "type": "string",
            "example": "https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/"
          },
          "territorial_scope": {
            "type": "string",
            "example": "Great Britain (England, Scotland, Wales)"
          },
          "attribution_summary": {
            "type": "string"
          },
          "attribution_url": {
            "type": "string",
            "example": "https://api.postcodecontext.uk/api/v1/attribution"
          },
          "database_last_updated": {
            "type": "string",
            "example": "2026-10-23T11:35:00Z"
          },
          "baseline_vintage": {
            "type": "string",
            "example": "2026.10"
          },
          "update_cadence": {
            "type": "string",
            "example": "Monthly active refresh (HMLR, RoS & EPC); Quarterly (ONSPD); Periodic (Census & IMD)"
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AttributionSourceItem"
            }
          }
        }
      },
      "BillingReceipt": {
        "type": "object",
        "description": "Settled on-chain transaction receipt metadata under x402 payment specifications",
        "properties": {
          "mode": {
            "type": "string",
            "example": "x402_paid_settled"
          },
          "transactionHash": {
            "type": "string",
            "example": "0x123..."
          },
          "payer": {
            "type": "string",
            "example": "0xabc..."
          }
        }
      },
      "AttributionSourceItem": {
        "type": "object",
        "required": [
          "dataset",
          "provider",
          "coverage",
          "licence",
          "licence_url",
          "mandatory_statement",
          "vintage",
          "last_updated",
          "update_frequency"
        ],
        "properties": {
          "dataset": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "coverage": {
            "type": "string"
          },
          "licence": {
            "type": "string"
          },
          "licence_url": {
            "type": "string"
          },
          "mandatory_statement": {
            "type": "string"
          },
          "vintage": {
            "type": "string"
          },
          "last_updated": {
            "type": "string"
          },
          "update_frequency": {
            "type": "string"
          }
        }
      }
    }
  }
}
