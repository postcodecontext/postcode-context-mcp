{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.postcodecontext.uk/schemas/postcode-intelligence.json",
  "title": "PostcodeIntelligenceResponse",
  "type": "object",
  "description": "Comprehensive Great Britain postcode socio-economic profile. Sliced views prune optional metric blocks to optimize LLM context window token efficiency: full (complete 113-metric profile, default), brief/summary/ai (summary_for_ai, location, _attribution, _licensing, _billing, ~80 tokens), property (property_and_energy, digital_infrastructure), demographics (deprivation_deciles, census_demographics), education (schools_and_education), healthcare (healthcare_and_services), transit (transit), or services (education, healthcare, transit, digital_infrastructure). The _attribution property is strictly required and preserved across all view slices in accordance with statutory Open Government Licence v3.0, Ordnance Survey OpenData, and Crown copyright requirements.",
  "required": [
    "_attribution"
  ],
  "properties": {
    "match_type": {
      "type": "string",
      "enum": [
        "exact_unit",
        "district_fallback"
      ],
      "example": "exact_unit",
      "description": "Resolution accuracy: exact_unit (matched unit postcode in directory) or district_fallback (aggregated outcode postal district profile)"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "exact",
        "approximate"
      ],
      "example": "exact",
      "description": "Downstream agent confidence indicator"
    },
    "requested_postcode": {
      "type": "string",
      "example": "SW1A 1AA",
      "description": "Normalized display representation of the requested postcode"
    },
    "resolved_district": {
      "type": [
        "string",
        "null"
      ],
      "example": "SW1A",
      "description": "Outward postal district code if fallback was applied (null on exact unit matches)"
    },
    "note": {
      "type": [
        "string",
        "null"
      ],
      "example": "Exact unit postcode not yet in Census/ONS directory. Returning aggregated SW1A district profile.",
      "description": "Explanatory contextual note for fallback profiles (null on exact unit matches)"
    },
    "summary_for_ai": {
      "$ref": "#/components/schemas/SummaryForAI"
    },
    "location": {
      "$ref": "#/components/schemas/Location"
    },
    "property_and_energy": {
      "$ref": "#/components/schemas/PropertyAndEnergy"
    },
    "deprivation_deciles": {
      "$ref": "#/components/schemas/DeprivationDeciles"
    },
    "census_demographics": {
      "$ref": "#/components/schemas/CensusDemographics"
    },
    "digital_infrastructure": {
      "$ref": "#/components/schemas/DigitalInfrastructure"
    },
    "schools_and_education": {
      "$ref": "#/components/schemas/EducationAndSchools"
    },
    "healthcare_and_services": {
      "$ref": "#/components/schemas/HealthcareAndServices"
    },
    "transit": {
      "$ref": "#/components/schemas/Transit"
    },
    "landmark_context": {
      "$ref": "#/components/schemas/LandmarkContext"
    },
    "_disclaimer": {
      "type": "string",
      "description": "Statutory non-advice legal disclaimer"
    },
    "_attribution": {
      "type": "string",
      "description": "Official statutory Crown copyright and Open Government Licence v3.0 attribution statement (mandatory across all views)"
    },
    "_licensing": {
      "$ref": "#/components/schemas/LicensingInfo"
    },
    "_billing": {
      "$ref": "#/components/schemas/BillingReceipt"
    }
  },
  "components": {
    "schemas": {
      "SummaryForAI": {
        "type": "object",
        "required": [
          "ai_context_briefing",
          "primary_persona_tag",
          "affluence_tier",
          "b2c_spending_propensity"
        ],
        "properties": {
          "ai_context_briefing": {
            "type": "string",
            "description": "Pre-synthesised dense natural language summary designed for LLM context window injection"
          },
          "primary_persona_tag": {
            "type": "string",
            "description": "Target marketing and socio-economic persona archetype"
          },
          "affluence_tier": {
            "type": "string",
            "enum": [
              "Ultra-Prime",
              "Affluent",
              "Mid-Market",
              "Modest-Income",
              "High-Deprivation"
            ],
            "description": "Categorical socio-economic bracket segmenting Great Britain residential neighbourhoods into 5 macro cohorts"
          },
          "b2c_spending_propensity": {
            "type": "string",
            "description": "Inferred neighbourhood consumer expenditure profile derived from local affluence tier and tenure. Represents a macro area characteristic, not an observed financial record of an individual household."
          },
          "affluence_score_100": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 100,
            "description": "Composite socio-economic score from 1 to 100 (weighted: 35% modelled income, 25% human capital qualifications/NS-SeC, 25% IMD deprivation freedom, 15% homeownership equity; ~10 points represents ~1 national decile shift)"
          },
          "family_suitability_score_100": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 100,
            "description": "Composite family suitability score from 1 to 100 (weighted: 40% statutory crime safety decile, 30% statutory education/skills deprivation decile, 30% child and parenting-age demographic density)"
          },
          "commuter_connectivity_score_100": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 100,
            "description": "Composite multi-modal connectivity score from 1 to 100 (evaluating straight-line geodesic distance to nearest rail/rapid transit station, strategic intercity hub tier, zero-car transit reliance density, broadband speed tier, and affluence)"
          },
          "property_value_index": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 100,
            "description": "Relative property valuation index benchmarked against prime central London baseline (£16,200/sqm ceiling = 100)"
          }
        }
      },
      "Location": {
        "type": "object",
        "required": [
          "postcode",
          "clean_postcode",
          "outcode",
          "incode",
          "lsoa_code",
          "lsoa_name",
          "local_authority",
          "constituency",
          "region_or_nation",
          "rural_urban_classification",
          "latitude",
          "longitude"
        ],
        "properties": {
          "postcode": {
            "type": "string",
            "example": "SW1A 1AA"
          },
          "clean_postcode": {
            "type": "string",
            "example": "SW1A1AA"
          },
          "outcode": {
            "type": "string",
            "example": "SW1A"
          },
          "incode": {
            "type": "string",
            "example": "1AA"
          },
          "lsoa_code": {
            "type": "string",
            "example": "E01004736"
          },
          "msoa_code": {
            "type": [
              "string",
              "null"
            ],
            "example": "E02000977"
          },
          "lsoa_name": {
            "type": "string",
            "example": "Westminster 018C"
          },
          "local_authority": {
            "type": "string",
            "example": "Westminster"
          },
          "constituency": {
            "type": "string",
            "example": "Cities of London and Westminster"
          },
          "region_or_nation": {
            "type": "string",
            "example": "London"
          },
          "rural_urban_classification": {
            "type": "string",
            "example": "Urban major conurbation"
          },
          "latitude": {
            "type": "number",
            "example": 51.501009
          },
          "longitude": {
            "type": "number",
            "example": -0.141588
          }
        }
      },
      "PropertyAndEnergy": {
        "type": "object",
        "required": [
          "price_basis"
        ],
        "properties": {
          "median_house_price_gbp": {
            "type": [
              "integer",
              "null"
            ],
            "example": 1250000,
            "description": "HM Land Registry (E&W 2024–2026) and Registers of Scotland (Scotland 2023–2025) 3-year rolling median transaction price in GBP (nullable for 0-transaction areas)"
          },
          "price_per_sqm_gbp": {
            "type": [
              "integer",
              "null"
            ],
            "example": 14200,
            "description": "Synthetic property valuation benchmark joining 3-year rolling median transaction prices (HMLR / RoS) with domestic mean internal floor areas (Open EPC / Scottish EPC Register) at postcode level (nullable if no EPC or sales recorded)"
          },
          "price_basis": {
            "type": "object",
            "required": [
              "resolution",
              "window",
              "n"
            ],
            "properties": {
              "resolution": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "postcode",
                  "data_zone",
                  "outcode_district",
                  "local_authority",
                  null
                ],
                "description": "Spatial granularity of the median property valuation"
              },
              "window": {
                "type": [
                  "string",
                  "null"
                ],
                "example": "2024–2026",
                "description": "Rolling temporal transaction window (2024–2026 for England & Wales, 2023–2025 for Scotland)"
              },
              "n": {
                "type": [
                  "integer",
                  "null"
                ],
                "example": 18,
                "description": "Number of recorded transactions in rolling window used to compute median price"
              }
            }
          },
          "sales_volume_3yr": {
            "type": [
              "integer",
              "null"
            ],
            "example": 118,
            "description": "Recorded sales volume in 3-year window"
          },
          "dominant_property_type": {
            "type": [
              "string",
              "null"
            ],
            "example": "Flat/Maisonette"
          },
          "avg_floor_area_sqm": {
            "type": [
              "number",
              "null"
            ],
            "example": 88
          },
          "epc_rating_current": {
            "type": [
              "string",
              "null"
            ],
            "example": "C"
          },
          "epc_rating_potential": {
            "type": [
              "string",
              "null"
            ],
            "example": "B"
          },
          "retrofit_upside_potential": {
            "type": [
              "string",
              "null"
            ]
          },
          "pre_1930_housing_pct": {
            "type": [
              "number",
              "null"
            ],
            "example": 34
          }
        }
      },
      "DeprivationDeciles": {
        "type": "object",
        "required": [
          "_scale_explanation"
        ],
        "properties": {
          "_scale_explanation": {
            "type": "string"
          },
          "imd_overall_decile": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 10
          },
          "imd_overall_rank": {
            "type": [
              "integer",
              "null"
            ]
          },
          "income_deprivation_decile": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 10
          },
          "employment_deprivation_decile": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 10
          },
          "education_skills_decile": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 10
          },
          "health_deprivation_decile": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 10
          },
          "crime_safety_decile": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 10,
            "description": "Statutory Crime Deprivation Decile (1-10) from the English IoD 2025, Welsh WIMD 2025, and Scottish SIMD 2020 (1 = highest recorded crime deprivation nationally, 10 = lowest recorded crime deprivation / safest 10%). Sourced from multi-year police records per capita at LSOA level. Represents neighbourhood historical baseline, not individual personal victimisation risk."
          },
          "housing_barriers_decile": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 10
          },
          "living_environment_decile": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 10
          }
        }
      },
      "CensusDemographics": {
        "type": "object",
        "required": [],
        "properties": {
          "population_density_per_sqkm": {
            "type": [
              "integer",
              "null"
            ],
            "example": 6800
          },
          "est_median_household_income_gbp": {
            "type": [
              "integer",
              "null"
            ],
            "example": 29500,
            "description": "Heuristic small-area estimate of annual median gross disposable household income in GBP (LSOA/Data Zone level) derived from a linear formula weighting DWP/HMRC income deprivation deciles, Census NS-SeC managerial occupation shares, and Level 4 qualifications, clamped at £21,000–£95,000. Not an observed Census return."
          },
          "tenure_breakdown_pct": {
            "type": "object",
            "properties": {
              "owned_outright": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "mortgaged": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "private_rented": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "social_rented": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          },
          "qualifications_pct": {
            "type": "object",
            "properties": {
              "degree_or_higher_level4_plus": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "no_qualifications": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          },
          "ns_sec_managerial_professional_pct": {
            "type": [
              "number",
              "null"
            ]
          },
          "economically_active_employed_pct": {
            "type": [
              "number",
              "null"
            ]
          },
          "retired_pct": {
            "type": [
              "number",
              "null"
            ]
          },
          "student_pct": {
            "type": [
              "number",
              "null"
            ]
          },
          "work_from_home_pct": {
            "type": [
              "number",
              "null"
            ]
          },
          "car_ownership_pct": {
            "type": "object",
            "properties": {
              "zero_cars": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "two_or_more_cars": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          },
          "age_distribution_pct": {
            "type": "object",
            "properties": {
              "age_0_to_15": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "age_16_to_29": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "age_30_to_44": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "age_45_to_64": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "age_65_plus": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          }
        }
      },
      "DigitalInfrastructure": {
        "type": "object",
        "required": [],
        "properties": {
          "broadband_speed_tier_mbps": {
            "type": [
              "number",
              "null"
            ],
            "example": 74.2,
            "description": "Estimated fixed broadband download speed tier in Mbps (350, 120, 80, or 68.5 Mbps baseline derived from Ofcom Connected Nations availability brackets)"
          },
          "median_download_mbps": {
            "type": [
              "number",
              "null"
            ],
            "example": 74.2,
            "deprecated": true,
            "description": "Legacy backwards-compatibility alias for broadband_speed_tier_mbps (modelled Ofcom availability tier, not an observed speed-test median)"
          },
          "gigabit_availability_pct": {
            "type": [
              "number",
              "null"
            ],
            "example": 89.4
          }
        }
      },
      "EducationAndSchools": {
        "type": "object",
        "properties": {
          "nearest_primary_school": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SchoolSummary"
              },
              {
                "type": "null"
              }
            ]
          },
          "nearest_secondary_school": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SchoolSummary"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "SchoolSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "ENG-101138"
          },
          "name": {
            "type": "string",
            "example": "St Matthew's School, Westminster"
          },
          "phase": {
            "type": "string",
            "example": "Primary"
          },
          "gender": {
            "type": "string",
            "example": "Mixed"
          },
          "religious_character": {
            "type": [
              "string",
              "null"
            ],
            "example": "Church of England"
          },
          "admissions_policy": {
            "type": [
              "string",
              "null"
            ],
            "example": "Non-selective"
          },
          "distance_km": {
            "type": "number",
            "example": 0.54
          }
        }
      },
      "HealthcareAndServices": {
        "type": "object",
        "properties": {
          "nearest_gp_surgery": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/HealthcareSummary"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "HealthcareSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "CQC-1-12687408410"
          },
          "name": {
            "type": "string",
            "example": "Medloop"
          },
          "care_type": {
            "type": "string",
            "example": "GP Practice"
          },
          "distance_km": {
            "type": "number",
            "example": 0.48
          },
          "regulator": {
            "type": "string",
            "example": "CQC"
          },
          "rating": {
            "type": [
              "string",
              "null"
            ],
            "example": "Good"
          },
          "inspection_date": {
            "type": [
              "string",
              "null"
            ],
            "example": "22/Jan/2024"
          }
        }
      },
      "Transit": {
        "type": "object",
        "properties": {
          "nearest_station": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/StationSummary"
              },
              {
                "type": "null"
              }
            ],
            "description": "Closest rail, metro, or tram stop of any category"
          },
          "nearest_intercity_hub": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/StationSummary"
              },
              {
                "type": "null"
              }
            ],
            "description": "Closest primary mainline intercity railway hub (>= 2M annual passengers or Network Rail Category A/B interchange)"
          }
        }
      },
      "StationSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "9100MNCRVIC"
          },
          "name": {
            "type": "string",
            "example": "Manchester Victoria"
          },
          "station_type": {
            "type": "string",
            "example": "National Rail"
          },
          "hub_type": {
            "type": "string",
            "enum": [
              "national_hub",
              "regional_hub",
              "commuter_hub",
              "local_station"
            ],
            "example": "national_hub",
            "description": "Station hierarchy classification based on ORR annual passenger footfall: national_hub (>=10M/yr or Cat A), regional_hub (>=2M/yr or Cat B), commuter_hub (500k-2M/yr), or local_station (<500k/yr)."
          },
          "distance_km": {
            "type": "number",
            "example": 0.35
          }
        }
      },
      "LandmarkContext": {
        "type": "object",
        "required": [
          "is_national_landmark"
        ],
        "properties": {
          "is_national_landmark": {
            "type": "boolean",
            "example": true,
            "description": "True if this postcode represents a major national landmark, royal palace, civic seat, or special non-geographic entity"
          },
          "landmark_name": {
            "type": [
              "string",
              "null"
            ],
            "example": "Buckingham Palace"
          },
          "landmark_category": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "Royal Residence",
              "Government & Executive",
              "Parliamentary & Civic",
              "National Defence & Security",
              "Central Banking & Financial",
              "National Heritage & Cathedral",
              "Diplomatic & Embassy",
              "Academic & Historic Seat",
              "Healthcare & Medical Research",
              "Correctional & Institutional",
              "National Sports & Culture",
              "Major Transport Hub",
              "Special Non-Geographic",
              "Military Overseas & BFPO",
              null
            ],
            "example": "Royal Residence"
          },
          "demographic_distortion_note": {
            "type": [
              "string",
              "null"
            ],
            "example": "Census demographics reflect residential blocks in Westminster 018C (Wellington Barracks and rental flats towards Victoria), not the Royal Household."
          }
        }
      },
      "LicensingInfo": {
        "type": "object",
        "required": [
          "licence",
          "licence_url",
          "territorial_scope",
          "attribution_summary",
          "database_last_updated",
          "baseline_vintage",
          "update_cadence"
        ],
        "properties": {
          "licence": {
            "type": "string",
            "example": "Open Government Licence v3.0"
          },
          "licence_url": {
            "type": "string",
            "example": "https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/"
          },
          "territorial_scope": {
            "type": "string",
            "example": "Great Britain (England, Scotland, Wales)"
          },
          "attribution_summary": {
            "type": "string"
          },
          "attribution_url": {
            "type": "string",
            "example": "https://api.postcodecontext.uk/api/v1/attribution"
          },
          "database_last_updated": {
            "type": "string",
            "example": "2026-10-23T11:35:00Z"
          },
          "baseline_vintage": {
            "type": "string",
            "example": "2026.10"
          },
          "update_cadence": {
            "type": "string",
            "example": "Monthly active refresh (HMLR, RoS & EPC); Quarterly (ONSPD); Periodic (Census & IMD)"
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AttributionSourceItem"
            }
          }
        }
      },
      "BillingReceipt": {
        "type": "object",
        "description": "Settled on-chain transaction receipt metadata under x402 payment specifications",
        "properties": {
          "mode": {
            "type": "string",
            "example": "x402_paid_settled"
          },
          "transactionHash": {
            "type": "string",
            "example": "0x123..."
          },
          "payer": {
            "type": "string",
            "example": "0xabc..."
          }
        }
      },
      "AttributionSourceItem": {
        "type": "object",
        "required": [
          "dataset",
          "provider",
          "coverage",
          "licence",
          "licence_url",
          "mandatory_statement",
          "vintage",
          "last_updated",
          "update_frequency"
        ],
        "properties": {
          "dataset": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "coverage": {
            "type": "string"
          },
          "licence": {
            "type": "string"
          },
          "licence_url": {
            "type": "string"
          },
          "mandatory_statement": {
            "type": "string"
          },
          "vintage": {
            "type": "string"
          },
          "last_updated": {
            "type": "string"
