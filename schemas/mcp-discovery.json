{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.postcodecontext.uk/schemas/mcp-discovery.json",
  "title": "MCP Server Discovery Manifest Schema",
  "type": "object",
  "required": [
    "name",
    "version",
    "description",
    "provider",
    "servers",
    "tools"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "provider": {
      "type": "object",
      "required": [
        "organization",
        "url"
      ],
      "properties": {
        "organization": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "contact": {
          "type": "string"
        }
      }
    },
    "documentation": {
      "type": "object",
      "properties": {
        "home": {
          "type": "string"
        },
        "openapi": {
          "type": "string"
        },
        "dictionary": {
          "type": "string"
        },
        "attribution": {
          "type": "string"
        },
        "legal": {
          "type": "string"
        }
      }
    },
    "coverage": {
      "type": "object",
      "properties": {
        "territorial_scope": {
          "type": "string"
        },
        "exclusions": {
          "type": "string"
        }
      }
    },
    "servers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "endpoint",
          "transport",
          "protocolVersion"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "endpoint": {
            "type": "string"
          },
          "transport": {
            "type": "string"
          },
          "protocolVersion": {
            "type": "string"
          },
          "supportedProtocolVersions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "authentication": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "protocol": {
                "type": "string"
              },
              "network": {
                "type": "string"
              },
              "token": {
                "type": "string"
              },
              "tokenAddress": {
                "type": "string"
              },
              "tokenDecimals": {
                "type": "integer"
              },
              "recipient": {
                "type": "string"
              },
              "rates": {
                "type": "object"
              },
              "atomicRates": {
                "type": "object"
              }
            }
          },
          "capabilities": {
            "type": "object",
            "properties": {
              "tools": {
                "type": "boolean"
              },
              "resources": {
                "type": "boolean"
              },
              "prompts": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "uri",
          "name"
        ],
        "properties": {
          "uri": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "mimeType": {
            "type": "string"
          }
        }
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "title",
          "description",
          "inputSchema"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "price": {
            "type": "string"
          },
          "inputSchema": {
            "type": "object"
          },
          "annotations": {
            "type": "object",
            "properties": {
              "readOnlyHint": {
                "type": "boolean"
              },
              "destructiveHint": {
                "type": "boolean"
              },
              "idempotentHint": {
                "type": "boolean"
              },
              "openWorldHint": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  }
}
